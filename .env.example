# Google AI Studio Gemini API Key
GEMINI_API_KEY=

# Supabase Client Configuration (Optional - app falls back to local in-memory/localStorage if omitted)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth Client ID (Optional - production fallback client ID provided in app)
VITE_GOOGLE_CLIENT_ID=

# Lemon Squeezy Store and Checkout Configuration (Optional - fallback URLs provided in app)
VITE_LEMONSQUEEZY_STORE_ID=
VITE_LEMONSQUEEZY_PAYG_3_URL=
VITE_LEMONSQUEEZY_PAYG_10_URL=
VITE_LEMONSQUEEZY_PAYG_50_URL=
VITE_LEMONSQUEEZY_LITE_URL=
VITE_LEMONSQUEEZY_PRO_URL=
VITE_LEMONSQUEEZY_UNLIMITED_URL=

# Remote AI Inference Server URL (Optional - client-side WebGPU/WASM model used by default)
VITE_API_BASE_URL=

# Custom Self-Hosted / Mirror URL for AI Models (Optional - defaults to staticimgly CDN)
VITE_IMGLY_PUBLIC_PATH=

# Server-side Guest Rate Limiting & Supabase Admin Keys (used by Vercel serverless /api/guest-credit)
GUEST_RATE_SALT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
