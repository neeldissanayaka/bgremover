# Environment variables template for bgremover.art

# Supabase Configuration (Optional - local fallback storage is active by default)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth Client ID (Optional)
VITE_GOOGLE_CLIENT_ID=

# External API base URL (Optional - client-side AI WASM runs by default)
VITE_API_BASE_URL=

# Gemini API Key (Optional)
GEMINI_API_KEY=
